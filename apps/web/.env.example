# Local development and browser tests must use local Supabase.
# Production values are managed by Sites and must never be copied here.
# VITE_SUPABASE_ANON_KEY may only use an anon public key.
# Do not use a service role key in frontend.
# Do not commit .env.local.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_DATA_PROVIDER=published
VITE_ENABLE_PUBLISHED_PROVIDER=true
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JUDICIAL_OPEN_DATA_USER=
JUDICIAL_OPEN_DATA_PASSWORD=
