{
  "name": "public-office-watch-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:rehearsal": "vite --mode rehearsal",
    "build:sites": "node scripts/check-environment.mjs production && node scripts/prepare-sites-build.mjs --clean && tsc -b && vite build --outDir dist/client && node scripts/generate-seo-catalog.mjs dist/client/seo-catalog.json && node scripts/prepare-sites-build.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "smoke:public-views": "node scripts/smoke-public-views.mjs",
    "smoke:published-rehearsal": "node scripts/smoke-published-rehearsal.mjs",
    "measure:public-reads": "node scripts/measure-public-read-performance.mjs",
    "check:data-boundary": "node scripts/check-public-data-boundary.mjs",
    "check:public-view-contracts": "node scripts/check-public-view-contracts.mjs",
    "check:published-exposure": "node scripts/check-published-exposure-boundary.mjs",
    "test:read-contracts": "node --test --experimental-strip-types tests/*.test.ts",
    "preflight:production-readiness": "node scripts/preflight-production-readiness.mjs",
    "prepare:tw-map:counties": "node scripts/prepare-taiwan-county-map.mjs",
    "check:local-test-env": "node scripts/check-environment.mjs local",
    "check:production-env": "node scripts/check-environment.mjs production",
    "test:browser": "npm run check:local-test-env && playwright test",
    "test:browser:production": "node scripts/check-environment.mjs production-smoke && playwright test --config=playwright.production.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "globals": "^15.11.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10"
  }
}
