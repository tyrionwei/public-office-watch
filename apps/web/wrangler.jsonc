{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "public-office-watch",
  "main": "./worker/sites-static.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": "./dist/cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/people",
      "/people/*",
      "/elections",
      "/elections/*",
      "/parties",
      "/parties/*",
      "/regions/*",
      "/updates",
      "/data-guidance",
      "/about",
      "/internal/*",
      "/robots.txt",
      "/sitemap.xml",
      "/sitemaps/*"
    ]
  }
}
